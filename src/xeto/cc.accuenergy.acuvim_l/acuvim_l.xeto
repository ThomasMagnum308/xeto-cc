// Device model for Accuenergy's Acuvim-L Series Power Meter
AcuvimLElecAcMeter : AcElecMeter <abstract> {
  resources: List? <of:File> {
    PdfFile {
      dis: "Acuvim-L Multifunction Power and Energy Meter User Manual"
      uri: "https://www.accuenergy.com/wp-content/uploads/Acuvim-L-Multifunction-Power-and-Energy-Meter-User-Manual-v4.pdf"
    }
  }
  attrs: Query {
    ManufacturerAttr { val: "Accuenergy" }
    ModelSeriesAttr { val: "Acuvim-L" }
    DimensionLengthAttr { val: 96mm }
    DimensionWidthAttr { val: 96mm }
    DimensionHeightAttr { val: 64.3mm }
    MinRatedOperatingTempAttr { val: -25°C }
    MaxRatedOperatingTempAttr { val: 70°C }
  }
  points: {
    reg8576: ElecAcFreqSensor? {
      dis: "Frequency"
      bacnetCurAddr: { addr: "AI1" }
      modbusCurAddr: { addr: "408577", encoding: "f4" }
    }
    reg8578: ElecAcRmsVoltageSensor? {
      elecL1
      dis: "Phase 1 Voltage"
      bacnetCurAddr: { addr: "AI2" }
      modbusCurAddr: { addr: "408579", encoding: "f4" }
    }
    reg8580: ElecAcRmsVoltageSensor? {
      elecL2
      dis: "Phase 2 Voltage"
      bacnetCurAddr: { addr: "AI3" }
      modbusCurAddr: { addr: "408581", encoding: "f4" }
    }
    reg8582: ElecAcRmsVoltageSensor? {
      elecL3
      dis: "Phase 3 Voltage"
      bacnetCurAddr: { addr: "AI4" }
      modbusCurAddr: { addr: "408583", encoding: "f4" }
    }
    reg8584: ElecAcLineAvgRmsVoltageSensor? {
      dis: "Average Phase Voltage"
      bacnetCurAddr: { addr: "AI5" }
      modbusCurAddr: { addr: "408585", encoding: "f4" }
    }
    reg8586: ElecAcRmsVoltageSensor? {
      elecL1L2
      dis: "Line Voltage 1-2"
      bacnetCurAddr: { addr: "AI6" }
      modbusCurAddr: { addr: "408587", encoding: "f4" }
    }
    reg8588: ElecAcRmsVoltageSensor? {
      elecL2L3
      dis: "Line Voltage 2-3"
      bacnetCurAddr: { addr: "AI7" }
      modbusCurAddr: { addr: "408589", encoding: "f4" }
    }
    reg8590: ElecAcRmsVoltageSensor? {
      elecL3L1
      dis: "Line Voltage 3-1"
      bacnetCurAddr: { addr: "AI8" }
      modbusCurAddr: { addr: "408591", encoding: "f4" }
    }
    reg8592: ElecAcLineToLineAvgRmsVoltageSensor? {
      dis: "Average Line Voltage"
      bacnetCurAddr: { addr: "AI9" }
      modbusCurAddr: { addr: "408593", encoding: "f4" }
    }
    reg8594: ElecAcRmsCurrentSensor? {
      elecL1
      dis: "Total Phase A Current"
      bacnetCurAddr: { addr: "AI10" }
      modbusCurAddr: { addr: "408595", encoding: "f4" }
    }
    reg8596: ElecAcRmsCurrentSensor? {
      elecL2
      dis: "Total Phase B Current"
      bacnetCurAddr: { addr: "AI11" }
      modbusCurAddr: { addr: "408597", encoding: "f4" }
    }
    reg8598: ElecAcRmsCurrentSensor? {
      elecL3
      dis: "Total Phase C Current"
      bacnetCurAddr: { addr: "AI12" }
      modbusCurAddr: { addr: "408599", encoding: "f4" }
    }
    reg8606: ElecAcLineAvgRmsCurrentSensor? {
      dis: "Average Current"
      bacnetCurAddr: { addr: "AI13" }
      modbusCurAddr: { addr: "408607", encoding: "f4" }
    }
    reg8600: ElecAcNeutralRmsCurrentSensor? {
      dis: "Neutral Current Calculated"
      bacnetCurAddr: { addr: "AI14" }
      modbusCurAddr: { addr: "408601", encoding: "f4" }
    }
    reg8608: ElecAcNetActivePowerSensor? {
      elecL1
      dis: "Phase A Power"
      bacnetCurAddr: { addr: "AI15" }
      modbusCurAddr: { addr: "408609", encoding: "f4", scale: "*0.001" }
    }
    reg8610: ElecAcNetActivePowerSensor? {
      elecL2
      dis: "Phase B Power"
      bacnetCurAddr: { addr: "AI16" }
      modbusCurAddr: { addr: "408611", encoding: "f4", scale: "*0.001" }
    }
    reg8612: ElecAcNetActivePowerSensor? {
      elecL3
      dis: "Phase C Power"
      bacnetCurAddr: { addr: "AI17" }
      modbusCurAddr: { addr: "408613", encoding: "f4", scale: "*0.001" }
    }
    reg8614: ElecAcTotalNetActivePowerSensor? {
      dis: "Total System Power"
      bacnetCurAddr: { addr: "AI18" }
      modbusCurAddr: { addr: "408615", encoding: "f4", scale: "*0.001" }
    }
    reg8616: ElecAcNetReactivePowerSensor? {
      elecL1
      dis: "Phase A Reactive Power"
      bacnetCurAddr: { addr: "AI19" }
      modbusCurAddr: { addr: "408617", encoding: "f4", scale: "*0.001" }
    }
    reg8618: ElecAcNetReactivePowerSensor? {
      elecL2
      dis: "Phase B Reactive Power"
      bacnetCurAddr: { addr: "AI20" }
      modbusCurAddr: { addr: "408619", encoding: "f4", scale: "*0.001" }
    }
    reg8620: ElecAcNetReactivePowerSensor? {
      elecL3
      dis: "Phase C Reactive Power"
      bacnetCurAddr: { addr: "AI21" }
      modbusCurAddr: { addr: "408621", encoding: "f4", scale: "*0.001" }
    }
    reg8622: ElecAcTotalNetReactivePowerSensor? {
      dis: "Total Reactive Power"
      bacnetCurAddr: { addr: "AI22" }
      modbusCurAddr: { addr: "408623", encoding: "f4", scale: "*0.001" }
    }
    reg8624: ElecAcApparentPowerSensor? {
      elecL1
      dis: "Phase A Apparent Power"
      bacnetCurAddr: { addr: "AI23" }
      modbusCurAddr: { addr: "408625", encoding: "f4", scale: "*0.001" }
    }
    reg8626: ElecAcApparentPowerSensor? {
      elecL2
      dis: "Phase B Apparent Power"
      bacnetCurAddr: { addr: "AI24" }
      modbusCurAddr: { addr: "408627", encoding: "f4", scale: "*0.001" }
    }
    reg8628: ElecAcApparentPowerSensor? {
      elecL3
      dis: "Phase C Apparent Power"
      bacnetCurAddr: { addr: "AI25" }
      modbusCurAddr: { addr: "408629", encoding: "f4", scale: "*0.001" }
    }
    reg8630: ElecAcTotalApparentPowerSensor? {
      dis: "Total Apparent Power"
      bacnetCurAddr: { addr: "AI26" }
      modbusCurAddr: { addr: "408631", encoding: "f4", scale: "*0.001" }
    }
    reg8632: ElecAcPfSensor? {
      elecPfTrue
      elecPfIec
      elecL1
      dis: "Phase A Power Factor"
      bacnetCurAddr: { addr: "AI27" }
      modbusCurAddr: { addr: "408633", encoding: "f4" }
    }
    reg8634: ElecAcPfSensor? {
      elecPfTrue
      elecPfIec
      elecL2
      dis: "Phase B Power Factor"
      bacnetCurAddr: { addr: "AI28" }
      modbusCurAddr: { addr: "408635", encoding: "f4" }
    }
    reg8636: ElecAcPfSensor? {
      elecPfTrue
      elecPfIec
      elecL3
      dis: "Phase C Power Factor"
      bacnetCurAddr: { addr: "AI29" }
      modbusCurAddr: { addr: "408637", encoding: "f4" }
    }
    reg8638: ElecAcTotalPfSensor? {
      elecPfTrue
      elecPfIec
      dis: "Total Power Factor"
      bacnetCurAddr: { addr: "AI30" }
      modbusCurAddr: { addr: "408639", encoding: "f4" }
    }
    reg8640: ElecAcLineToLineAvgQualityVoltageSensor? {
      imbalance
      dis: "Voltage Unbalance"
      bacnetCurAddr: { addr: "AI31" }
      modbusCurAddr: { addr: "408641", encoding: "f4", scale: "*100" }
    }
    reg8642: ElecAcLineAvgQualityCurrentSensor? {
      imbalance
      dis: "Current Unbalance"
      bacnetCurAddr: { addr: "AI32" }
      modbusCurAddr: { addr: "408643", encoding: "f4", scale: "*100" }
    }
    reg8646: ElecAcTotalNetActiveDemandSensor? {
      dis: "Power Demand"
      bacnetCurAddr: { addr: "AI34" }
      modbusCurAddr: { addr: "408647", encoding: "f4", scale: "*0.001" }
    }
    reg8648: ElecAcTotalNetReactiveDemandSensor? {
      dis: "Reactive Power Demand"
      bacnetCurAddr: { addr: "AI35" }
      modbusCurAddr: { addr: "408649", encoding: "f4", scale: "*0.001" }
    }
    reg8650: ElecAcTotalNetApparentDemandSensor? {
      dis: "Apparent Power Demand"
      bacnetCurAddr: { addr: "AI36" }
      modbusCurAddr: { addr: "408651", encoding: "f4", scale: "*0.001" }
    }
    reg8652: ElecAcCurrentDemandSensor? {
      elecL1
      dis: "Phase A Current Demand"
      bacnetCurAddr: { addr: "AI37" }
      modbusCurAddr: { addr: "408653", encoding: "f4" }
    }
    reg8654: ElecAcCurrentDemandSensor? {
      elecL2
      dis: "Phase B Current Demand"
      bacnetCurAddr: { addr: "AI38" }
      modbusCurAddr: { addr: "408655", encoding: "f4" }
    }
    reg8656: ElecAcCurrentDemandSensor? {
      elecL3
      dis: "Phase C Current Demand"
      bacnetCurAddr: { addr: "AI39" }
      modbusCurAddr: { addr: "408657", encoding: "f4" }
    }
    reg8320: ElecAcTotalImportActiveEnergySensor? {
      dis: "Import Active Energy"
      bacnetCurAddr: { addr: "AI40" }
      modbusCurAddr: { addr: "408321", encoding: "u4", scale: "*0.001" }
    }
    reg8322: ElecAcTotalExportActiveEnergySensor? {
      dis: "Export Active Energy"
      bacnetCurAddr: { addr: "AI41" }
      modbusCurAddr: { addr: "408323", encoding: "u4", scale: "*0.001" }
    }
    reg8336: ElecAcTotalImportReactiveEnergySensor? {
      dis: "Import Reactive Energy"
      bacnetCurAddr: { addr: "AI42" }
      modbusCurAddr: { addr: "408337", encoding: "u4", scale: "*0.001" }
    }
    reg8338: ElecAcTotalExportReactiveEnergySensor? {
      dis: "Export Reactive Energy"
      bacnetCurAddr: { addr: "AI43" }
      modbusCurAddr: { addr: "408339", encoding: "u4", scale: "*0.001" }
    }
    reg8326: ElecAcTotalNetActiveEnergySensor? {
      dis: "Net Active Energy"
      bacnetCurAddr: { addr: "AI45" }
      modbusCurAddr: { addr: "408327", encoding: "u4", scale: "*0.001" }
    }
    reg8342: ElecAcTotalNetReactiveEnergySensor? {
      dis: "Net Reactive Energy"
      bacnetCurAddr: { addr: "AI47" }
      modbusCurAddr: { addr: "408343", encoding: "u4", scale: "*0.001" }
    }
    reg8356: ElecAcTotalNetApparentEnergySensor? {
      dis: "Total Apparent Energy"
      bacnetCurAddr: { addr: "AI48" }
      modbusCurAddr: { addr: "408357", encoding: "u4", scale: "*0.001" }
    }
    reg8368: ElecAcImportActiveEnergySensor? {
      elecL1
      dis: "Phase A Import Active Energy"
      bacnetCurAddr: { addr: "AI49" }
      modbusCurAddr: { addr: "408369", encoding: "u4", scale: "*0.001" }
    }
    reg8370: ElecAcExportActiveEnergySensor? {
      elecL1
      dis: "Phase A Export Active Energy"
      bacnetCurAddr: { addr: "AI50" }
      modbusCurAddr: { addr: "408371", encoding: "u4", scale: "*0.001" }
    }
    reg8372: ElecAcImportActiveEnergySensor? {
      elecL2
      dis: "Phase B Import Active Energy"
      bacnetCurAddr: { addr: "AI51" }
      modbusCurAddr: { addr: "408373", encoding: "u4", scale: "*0.001" }
    }
    reg8374: ElecAcExportActiveEnergySensor? {
      elecL2
      dis: "Phase B Export Active Energy"
      bacnetCurAddr: { addr: "AI52" }
      modbusCurAddr: { addr: "408375", encoding: "u4", scale: "*0.001" }
    }
    reg8376: ElecAcImportActiveEnergySensor? {
      elecL3
      dis: "Phase C Import Active Energy"
      bacnetCurAddr: { addr: "AI53" }
      modbusCurAddr: { addr: "408377", encoding: "u4", scale: "*0.001" }
    }
    reg8378: ElecAcExportActiveEnergySensor? {
      elecL3
      dis: "Phase C Export Active Energy"
      bacnetCurAddr: { addr: "AI54" }
      modbusCurAddr: { addr: "408379", encoding: "u4", scale: "*0.001" }
    }
    reg8380: ElecAcImportReactiveEnergySensor? {
      elecL1
      dis: "Phase A Import Reactive Energy"
      bacnetCurAddr: { addr: "AI55" }
      modbusCurAddr: { addr: "408381", encoding: "u4", scale: "*0.001" }
    }
    reg8382: ElecAcExportReactiveEnergySensor? {
      elecL1
      dis: "Phase A Export Reactive Energy"
      bacnetCurAddr: { addr: "AI56" }
      modbusCurAddr: { addr: "408383", encoding: "u4", scale: "*0.001" }
    }
    reg8384: ElecAcImportReactiveEnergySensor? {
      elecL2
      dis: "Phase B Import Reactive Energy"
      bacnetCurAddr: { addr: "AI57" }
      modbusCurAddr: { addr: "408385", encoding: "u4", scale: "*0.001" }
    }
    reg8386: ElecAcExportReactiveEnergySensor? {
      elecL2
      dis: "Phase B Export Reactive Energy"
      bacnetCurAddr: { addr: "AI58" }
      modbusCurAddr: { addr: "408387", encoding: "u4", scale: "*0.001" }
    }
    reg8388: ElecAcImportReactiveEnergySensor? {
      elecL3
      dis: "Phase C Import Reactive Energy"
      bacnetCurAddr: { addr: "AI59" }
      modbusCurAddr: { addr: "408389", encoding: "u4", scale: "*0.001" }
    }
    reg8390: ElecAcExportReactiveEnergySensor? {
      elecL3
      dis: "Phase C Export Reactive Energy"
      bacnetCurAddr: { addr: "AI60" }
      modbusCurAddr: { addr: "408391", encoding: "u4", scale: "*0.001" }
    }
    reg8392: ElecAcImportApparentEnergySensor? {
      elecL1
      dis: "Phase A Import Apparent Energy"
      bacnetCurAddr: { addr: "AI61" }
      modbusCurAddr: { addr: "408393", encoding: "u4", scale: "*0.001" }
    }
    reg8396: ElecAcImportApparentEnergySensor? {
      elecL2
      dis: "Phase B Import Apparent Energy"
      bacnetCurAddr: { addr: "AI62" }
      modbusCurAddr: { addr: "408397", encoding: "u4", scale: "*0.001" }
    }
    reg8400: ElecAcImportApparentEnergySensor? {
      elecL3
      dis: "Phase C Import Apparent Energy"
      bacnetCurAddr: { addr: "AI63" }
      modbusCurAddr: { addr: "408401", encoding: "u4", scale: "*0.001" }
    }
    reg16478: ElecAcQualityCurrentSensor? {
      elecThd
      elecL1
      dis: "THD_I1"
      bacnetCurAddr: { addr: "AI68" }
      modbusCurAddr: { addr: "416479", encoding: "s2", scale: "*0.01" }
    }
    reg16479: ElecAcQualityCurrentSensor? {
      elecThd
      elecL2
      dis: "THD_I2"
      bacnetCurAddr: { addr: "AI69" }
      modbusCurAddr: { addr: "416480", encoding: "s2", scale: "*0.01" }
    }
    reg16480: ElecAcQualityCurrentSensor? {
      elecThd
      elecL3
      dis: "THD_I3"
      bacnetCurAddr: { addr: "AI70" }
      modbusCurAddr: { addr: "416481", encoding: "s2", scale: "*0.01" }
    }
    reg16481: ElecAcLineAvgQualityCurrentSensor? {
      elecThd
      dis: "THD_Iavg"
      bacnetCurAddr: { addr: "AI71" }
      modbusCurAddr: { addr: "416482", encoding: "s2", scale: "*0.01" }
