// Device model for Accuenergy's Acuvim-L Series Power Meter (2LL or 3LL
// wiring). In these wiring modes the voltage THD registers report line to
// line voltage THD: 405AH=V12, 405BH=V31, 405CH=V23 (Table 6-27).
AcuvimLElecAc2LLOr3LLMeter : AcuvimLElecAcMeter <abstract> {
  points: {
    reg16474: ElecAcQualityVoltageSensor? {
      elecThd
      elecL1L2
      dis: "THD_V12"
      bacnetCurAddr: { addr: "AI64" }
      modbusCurAddr: { addr: "416475", encoding: "s2", scale: "*0.01" }
    }
    reg16475: ElecAcQualityVoltageSensor? {
      elecThd
      elecL3L1
      dis: "THD_V31"
      bacnetCurAddr: { addr: "AI65" }
      modbusCurAddr: { addr: "416476", encoding: "s2", scale: "*0.01" }
    }
    reg16476: ElecAcQualityVoltageSensor? {
      elecThd
      elecL2L3
      dis: "THD_V23"
      bacnetCurAddr: { addr: "AI66" }
      modbusCurAddr: { addr: "416477", encoding: "s2", scale: "*0.01" }
    }
    reg16477: ElecAcLineToLineAvgQualityVoltageSensor? {
      elecThd
      dis: "THD_avg"
      bacnetCurAddr: { addr: "AI67" }
      modbusCurAddr: { addr: "416478", encoding: "s2", scale: "*0.01" }
    }

    //////////////////////////////////////////////////////////////////
    // Individual harmonics, 2nd-63rd order, plus odd/even total
    // harmonic distortion, crest factor, and THFF (Tables 6-28
    // through 6-30)
    //////////////////////////////////////////////////////////////////

