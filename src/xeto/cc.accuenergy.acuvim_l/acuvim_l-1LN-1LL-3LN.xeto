// Device model for Accuenergy's Acuvim-L Series Power Meter (1LN, 1LL, 3LN,
// or 3LN-2.5 wiring). In these wiring modes the voltage THD registers report
// phase voltage THD.
AcuvimLElecAc1LNOr1LLOr3LNMeter : AcuvimLElecAcMeter <abstract> {
  points: {
    reg16474: ElecAcQualityVoltageSensor? {
      elecThd
      elecL1
      dis: "THD_V1"
      bacnetCurAddr: { addr: "AI64" }
      modbusCurAddr: { addr: "416475", encoding: "s2", scale: "/100" }
    }
    reg16475: ElecAcQualityVoltageSensor? {
      elecThd
      elecL2
      dis: "THD_V2"
      bacnetCurAddr: { addr: "AI65" }
      modbusCurAddr: { addr: "416476", encoding: "s2", scale: "/100" }
    }
    reg16476: ElecAcQualityVoltageSensor? {
      elecThd
      elecL3
      dis: "THD_V3"
      bacnetCurAddr: { addr: "AI66" }
      modbusCurAddr: { addr: "416477", encoding: "s2", scale: "/100" }
    }
    reg16477: ElecAcLineAvgQualityVoltageSensor? {
      elecThd
      dis: "THD_avg"
      bacnetCurAddr: { addr: "AI67" }
      modbusCurAddr: { addr: "416478", encoding: "s2", scale: "/100" }
    }

    //////////////////////////////////////////////////////////////////
    // Individual harmonics, 2nd-63rd order, plus odd/even total
    // harmonic distortion, crest factor, and THFF (Tables 6-28
    // through 6-30)
